{"seg":["<big><b>אֶ</b></big>ת יְיָ אֱלֹהֶיךָ תִּירָא","וְאוֹתוֹ תַעֲבֹד בִּתְפִלָּה.","עֶרֶב","וּבֹקֶר יַחֲדֵהוּ","בְּאוֹת","וְטוֹטָפֹת לִתְהִלָּה:","<big><b>בִּ</b></big>כְנָפֶיךָ צִצִית נֶצַח","וּבִפְתָחֶיךָ מְזוּזָה סֶלָה.","כַּבֵּד הוֹרֶיךָ","יְרָא מֵהֶם כְּלָאֵל נָתַן לָמוֹ <big><b>גְּדֻלָּה</b></big>:","<big><b>גְּדֻלָּה</b></big> לִזְקֵנַי","וְהַדְרָתָם","וּמוֹרָא לַמִּקְדָּשׁ תָּקִים.","לִלְמֹד","וּלְלַמֵּד דָּת","וְהַמֶּלֶךְ יִקְרָאֶנָּה לָעָם בִּלְהָקִים:","<big><b>דְּ</b></big>חֵה הָאֱלִילִים","וְנִתַּצְתָּם","וְרֵעֶךָ כָּמוֹךָ תַּחַשְׁקֵם.","הָבִיאָהּ כֹּפֶר","וְצֶדֶק תִּרְדֹּף","וּמִשְׁקְלוֹתֶיךָ לַצַּדְּקָם <big><b>הָקֵם</b></big>:","<big><b>הָקֵם</b></big> תָּקִים","וְעָזוֹב תַּעֲזֹב","וְהַעַבֵט תַּעֲבִיט דֵּי חֶסְרוֹן.","הָשֵׁב תָּשִׁיב אֲבֵדָה","וְהַעֲנֵיק תַּעֲנִיק","וְהוֹכֵחַ לְכִשְׁרוֹן:","<big><b>וְ</b></big>חֵי אָחִיךָ עִמָּךְ","וּבֵרַכְתָּ בְשָּׂבְעֲךָ בְּרוֹן.","הִמּוֹל יִמּוֹל יְלִיד בֵּיתְךָ","וּמִקְנַת כַּסְפְּךָ לִבְרִית <big><b>זִכָּרוֹן</b></big>:","<big><b>זִכָּרוֹן</b></big>","שְׁמֹר הַשַּׁבָּת אַתָּה","וּבָנֶיךָ","וַעֲבָדֶךָ","וּבְהֶמְתְּךָ יִשְׁבְּתוּ בּוֹ.","רִאשׁוֹן","וּשְׁבִיעִי בְּנִיסָן","עֲצֶרֶת","וּתְרוּעָה קֹדֶשׁ לְנָקְבוּ:","<big><b>חֻ</b></big>קַּת הַכִּפּוּרִים קַדְּשֵׁהוּ","וְהֶחָג","וְהַשְּׁמִינִי בוֹ.","שָׁלֹש רְגָלִים תָּחֹג","וּמַתְּנַת יָד כְּבִרְכַּת <big><b>טוּבוֹ</b></big>:","<big><b>טוּבוֹ</b></big> בְּפֶסַח","מַצָּה","וּמָרוֹר","לְבַעֵר חָמֵץ וּלְכַלּוֹת.","שָׁבוּעוֹת","וְסֻכָּה","וְלוּלָב","תְּקִיעָה","וְעִנּוּי מִמַּאֲכָלוֹת:","<big><b>יַ</b></big>רְחֵי עִבּוּר","וּפֶסַח שֵׁנִי","וְשִׂמְחַת הַחַגִּים לְמַלֹּאת.","כְּתוֹב זֹאת רֶמֶז מְגִלָּה","וְנֵר יְמֵי חֲנֻכָּה עַד <big><b>כְּלוֹת</b></big>:","<big><b>כְּלוֹת</b></big> שֵׁשׁ שָׁנִים [תַּשְׁמֵט] הָאָרֶץ","וּבָהֶם תְּחַפֵּשׁ עֶבֶד עִבְרִי הַנִּלְקָח.","שְׁנַת הַחֲמִשִּׁים וּנְטַשְׁתָּהּ","וְגַם הָרָצוּעַ בָהּ יְפֻקַּח:","<big><b>לָ</b></big>תֵת תְּרוּמָה","וְרֵאשִׁית עֲרִיסֶךָ","וְהִלּוּלֵי קֹדֶשׁ מְרֻקָּח.","אַךְ תָּשִׁיב חֲבֹל לִצְרִיכָיו וּתְבֹרַךְ בְּכָל <big><b>מִקָּח</b></big>:","<big><b>מִקַּח</b></big> כֶּסֶף וּשְׁטָר וּבִיאָה בָּם בְּאִשָּׁה תָּרִיד.","שְׁאֵרָהּ","כְּסוּתָהּ","וְעוֹנָתָהּ בְּעוֹדֶנָּה","וּכְרִיתוּת בְּצֵאתָהּ לְהַפְרִיד:","<big><b>נִ</b></big>כְסַפְתָּ לִיפַת תֹּאַר גַּיְּרֶנָּה","וְתִבְחוֹן הַשּׂוֹטָה מֵהַמְרִיד.","יְבִמְתְּךָ חֲלֹץ אוֹ יַבֵּם אוּלַי יָקוּם <big><b>שָׂרִיד</b></big>:","<big><b>שָׂרִיד</b></big> מֵהַפִּיל שִׂים מַעֲקֶה","וּפְדֵה פֶּטֶר רֶחֶם בַּהִפָּתַח.","וּשְׁגַר בְּהֵמָה יְקַדֵּשׁוּן","וְיִפָּדֶה הָרֶכֶשׁ אוֹ יְנֻתַּח:","<big><b>עֵ</b></big>ת הַמְּקֻשָּׁרוֹת תְּבַכֵּרְנָה הַקְדִּישֵׁם מֵאֵין רֶתַח.","גֵּרֵי צֶדֶק כָאֶזְרָח","וְהַנְּבֵלָה לְתוֹשָׁבֵי <big><b>פֶתַח</b></big>:","<big><b>פֶּתַח</b></big> הַבִּכּוּרִים אִם פִּתֵּחוּ הֲבִיאֵם","וְתִקְרָא בְמִקְדָּשִׁים.","מַעֲשַׂר בְּהֵמָה","וּמַעֲשֵׂר רִאשׁוֹן","וּמַעֲשֵׂר אֶבְיוֹנִים מְדֻשִּׁים:","<big><b>צָ</b></big>עוֹד בַּשֵּׁנִי לַבְּחִירָה אוֹ תִפְדֵּהוּ וְדָמָיו מְקֻדָּשִׁים.","וְהִתְוַדִּיתָ בְּקַיֶּמְךָ כָּל אֵלֶּה בִּעַרְתִּי כָּל מַעְשְׂרוֹת <big><b>קֳדָשִׁים</b></big>:","<big><b>קֳדָשִׁים</b></big> רֵאשִׁית גִּזֶּךָ","וּמַתְּנוֹת זְבָחֶיךָ אַרְבַּע.","הִלְכוֹת שְׁחִיטָה תַּחְקֹר כַּדָּת","וּלְכַסּוֹת דָּם הַנּוֹבַע:","<big><b>רָ</b></big>חַב גְּבוּלֶךָ וְהִתְאַוִּית תְּדַשְּׁנֶה טוּבִי וְתִשְׂבַּע.","תֵּט אַחֲרֵי רַבִּים","בְּמִדְרְשֵׁי פָּנִים <big><b>שֶׁבַע</b></big>: <big><b>שֶׁבַע</b></big> וְתִשְׁעִים מִצְוֹת עֲשֵׂה אֵלֶּה תָּמִיד תִּגְמֹר. כִּי מִצְוֹת הַגּוּף הֵמָּה הַשְׂכִּילֵם וּמְעַדַנֵּיהֶם תִּזְמֹר: <big><b>תְּ</b></big>בוֹאָתְךָ טוֹבָה אֲשֶׁר צָפַנְתִּי פָּעַלְתִּי לַחוֹסִים לֵאמֹר. אִם תֵּלֵךְ בִּדְרָכַי חֻקַּי וּמִשְׁפָּטַי <big><b>תִּשְׁמֹר</b></big>:","<big><b>תִּשְׁמֹר</b></big> מוֹצָא שְׂפָתֶיךָ","כִּי תִדֹּר","וְתַפְלִיא לְהַזִּיר לְרָצוֹן.","תַּקְרִיב אִם תִּטְמָא בְּפֶתַע","וְעַל תּוֹרַת נְזִרָךְ לְעֶלְצוֹן:","<big><b>שַׁ</b></big>אֲנַנָּה בִּנְדָרֶיהָ וֶאֱסָרֶיהָ לְאָבִיהָ","וְאִשָׁהּ הַמֶּלְצוֹן.","אֶל הַמָּקוֹם אֲשֶׁר אֶבְחֲרָה בּוֹ תָבִיאוּ קָרְבָּנִי <big><b>רָצוֹן</b></big>:","<big><b>רָצוֹן</b></big> מִיּוֹם הַשְּׁמִינִי","עוֹלַת בָּקָר","וְצֹאן","וָעוֹף לְרִצְיוֹן.","גַּם שַׁלְמֵי בָקָר","וָצֹאן","וְאַרְבָּעִים לַחֲמֵי תּוֹדַת צִפְיוֹן:","<big><b>קָ</b></big>רְבַּן חֲלָבִים לְהָנִיף","חָזֶה וָשׁוֹק לִמְשָׁרְתֵי חֶבְיוֹן.","לִשְׂרֹף נוֹתָר לַבֹּקֶר","עוֹר הָעוֹלָה לְכֹהֲנֵי <big><b>צִבְיוֹן</b></big>:","<big><b>צִבְיוֹן</b></big> מִנְחַת סֹלֶת","מַחֲבַת","וּמַרְחֶשֶׁת","חַלּוֹת וּרְקִיקֶיהָ לְהַעֲרֵךְ.","בְּרִית מֶלַח","וּמַכֹּלֶת קֳדָשִׁים","וּמַחְלְקוֹת מְנָחוֹת תַּדְרֵךְ:","<big><b>פִּ</b></big>תֵּי הַחֲבִתִּים","וְחֵלֶק כְּחֵלֶק","וּמִמְכַּר מִשְׁמָר הַמְּבָרֵךְ.","רְחִיצַת מַיִם","וּתְרוּמַת דֶּשֶׁן","וּבַעֵר עֲצֵי אִשֵּׁה <big><b>עֶרֶךְ</b></big>:","<big><b>עֶרֶךְ</b></big> נֶפֶשׁ הָאָדָם כְּפִי שָׁנָיו","וּבְהֵמָה שֶׁלֹּא תָּבֹא אוּלָם.","עֶרְכֵי בָתִּים","וְחֹמֶשׁ בַּעֲלֵיהֶן","שְׂדֵה אֲחֻזָּה","וּמִקְּנֶה לְגָאֳלָם:","<big><b>שְׂ</b></big>עִירֵי עֲבוֹדַת נֵכָר לָעָם","וְלַיָּחִיד לְהוֹבִילָם.","שְׂדֵה חֲרָמִים","וְגֶזֶל הַגֵּר","וְחַטָּאת עַל כָּל <big><b>נֶעְלָם</b></big>:","<big><b>נֶעְלָם</b></big> מִקָּהָל","וּמָשִׁיחַ יָבִיא פָּר","וְהַנָּשִׂיא בְּשָׂעִיר יִתְכַּפֵּר.","עַם הָאָרֶץ בְּשֶׂה","וְגוֹזָלִים","וּבַעֲשִׂירִית הָאֵיפָה לְהַשַּׁפֵּר:","<big><b>מ</b></big>וֹעֵל","וְגוֹזֵל יָשִׁיב קֶרֶן וָחֹמֶשׁ וּבָאָשָׁם שִׁגְגָתוֹ יָפֵר.","וְאָשָׁם תָּלוּי","וּלְנֶחֱרֶפֶת","וְהֶקְדֵּשׁ בַּחֲמִישִׁיתוֹ <big><b>לְכַפֵּר</b></big>:","<big><b>לְכַפֵּר</b></big> מַגַּע חַטָּאת","וְדָמָהּ בְּכָל כְּלִי כְּחֻקַּת תְּמִימָה.","הַלְּוִיִּם יָרִימוּ מִמַּעַשְׂרוֹתָם לִמְשָׁרְתֵי הַמֶּלֶךְ פְּנִימָה:","<big><b>כֹּ</b></big>ה תְבָרְכוּ וְזֶה חָקְכֶם חֲמִשִּׁים וּשְׁמֹנֶה מִצְוֹת שַׁלְמָה.","וְקַדֵּשׁ מְכַהֵן מִן הַנֶּפֶשׁ","כִּי אִם לִשְׁאֵרוֹ <big><b>יִטַּמָּא</b></big>:","<big><b>יִטַּמָּא</b></big> מִן נִבְלַת בֶּהֱמַת טוֹהַר הַנּוֹגֵעַ","וְהַנּוֹשֵׂא","וְהָאֹכֵל כַּחֹק.","וְנוֹגֵעַ בְּטֻמְאָה","וְנוֹשְׂאָהּ","וְנוֹגֵעַ בַּשֶּׁרֶץ בִּדְחֹק:","<big><b>טֻ</b></big>מְאַת כֵּלִים","וְשֶׁבֶר חֶרֶשׂ","אֹכֶל","וּמַשְׁקֶה","וְזֵרוּעַ בִּמְחֹק.","תַּנּוּר וְכִירַיִם יֻתָּץ","בְּמַעֲיָן וָבוֹר לִלְמֹד <big><b>חֹק</b></big>:","<big><b>חֹק</b></big> שִׁכְבַת זֶרַע לְרוֹאֶהָ","וִיצוּעוֹ","וְלַשֹׁכֶבֶת חֵקוֹ מֵהַמְרוֹת.","דָּתֵי זָב","וְטַהֲרָתוֹ","וְקָרְבָּנוֹ","וְנִדָּה","וּבוֹעֲלָהּ נִזְהָרוֹת:","<big><b>זָ</b></big>בָה לִסְפֹּר","וּלְהַקְרִיב","שָׁבוּעַ","וּשְׁבוּעַיִם לַיּוֹלֶדֶת סְפוּרוֹת.","שְׁלֹשִׁים וּשְׁלֹשָׁה","וְכִפְלָם","וּלְהָבִיא קָרְבָּן <big><b>וּלְהוֹרוֹת</b></big>:","<big><b>וּלְהוֹרוֹת</b></big> מַרְאֵה עוֹר הַבָּשָׂר הַבַּהֶרֶת","וְהַמִּחְיָה רְתוּקִים.","אִם פָּרוֹחַ","וְהַצָּרֶבֶת","קָרַחַת וּרְעוּתָהּ","וְהַנְּתָקִים:","<big><b>הַ</b></big>בֹּהַק לְטַהֵר","וְהַבֶּגֶד","לְעֹשֶׁר הַמִּטַּהֵר","וְלְעָנְיוֹ חֻקִּים.","חֻקֵּי הַבַּיִת","וְטַהֲרוֹתָיו וְאָז יִירְשׁוּ בָּמוֹ <big><b>דְּבֵקִים</b></big>:","<big><b>דְּבֵקִים</b></big> בַּמֵּת יתְחַטְּאוּן בַּשְּׁלִישִׁי וּבַשְּׁבִיעִי כִּכְתָבָם.","מַזֶּה מֵי הַנִּדָּה יְכַבֵּס","וְכֵן יִטַמָּא הַנּוֹגֵעַ בָּם: <big><b>גְּ</b></big>מָר אַרְבָּעִים וְחָמֵשׁ מִצְוֹת פְּרִישַׁת טְמָאוֹת מִלְּקָרְבָם. הֻכְלְלוּ מֵאָה וְשָׁלֹשׁ מִצְוֹת כְּהֻנָּה כְּהִתְעָרְבוּ <big><b>בָם</b></big>: <big><b>בָּם</b></big> כְּנִכְלְלוּ הָרִאשׁוֹנוֹת נִמְצְאוּ מָאתַיִם נְגוֹהִים. אֵלֶּה הֵם מִצְוֹת עֲשֵׂה דְּבָרוֹ חָכְמוֹת רָאמוֹת גְּבוֹהִים:"]}